# Explicit browser origins allowed to call FastAPI directly.
DATA_GOV_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Single-process abuse controls for POST /api/v1/analyze.
DATA_GOV_RATE_LIMIT_ENABLED=true
DATA_GOV_RATE_LIMIT_BURST=5
DATA_GOV_RATE_LIMIT_REFILL_SECONDS=12
DATA_GOV_RATE_LIMIT_MAX_CLIENTS=10000

# Bound expensive work per API process.
DATA_GOV_MAX_CONCURRENT_ANALYSES=1
DATA_GOV_ADMISSION_WAIT_SECONDS=0.1
DATA_GOV_ANALYSIS_TIMEOUT_SECONDS=30
